# Telegram Bot API. Configure in Cloudflare runtime settings; never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Encrypts per-creator managed-bot tokens at rest. Use a random 32+ character secret.
MANAGED_BOT_ENCRYPTION_KEY=

# Official Minds Builder API client (fixed api.build.hellominds.ai endpoint).
# Create the Mind and Builder API key in the Minds Builder console. MINDS_MIND_ID
# must be the Mind UUID, not its display name or email. FairTurn verifies the
# Mind identity, enabled status, email, and available cognition at runtime.
MINDS_BUILDER_API_KEY=
MINDS_MIND_ID=

# Server-only longitudinal memory via Supabase REST. Prefer the newer sb_secret_ key.
# Never expose this key to the Telegram Mini App or any NEXT_PUBLIC variable.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Used for older admin-only workflows and the follow-up scheduler.
ADMIN_ACTION_SECRET=
CRON_SECRET=
